 reg_t kFlushResources(EngineState *s, int argc, reg_t *argv) {
+	// SQ3 calls FlushResources after disposing the old cast and just before
+	// starting the new room. Ordinary exits and save restores use SCI's state.
+	if (g_sci->getGameId() == GID_SQ3) {
+		int entry[4];
+		if (EM_ASM_INT({
+			const arrival = window.sq3.takeWalkArrival($0);
+			if (!arrival) return 0;
+			HEAP32.set([arrival.from, arrival.x, arrival.y, arrival.onRail ? 3 : 0], $1 >> 2);
+			return 1;
+		}, argv[0].toUint16(), entry)) {
+			reg_t *globals = s->variables[VAR_GLOBAL];
+			globals[kGlobalVarPreviousRoomNo] = make_reg(0, entry[0]);
+			globals[132] = make_reg(0, entry[3]); // Freighter rail travel mode
+			const reg_t ego = globals[kGlobalVarEgo];
+			writeSelectorValue(s->_segMan, ego, SELECTOR(x), entry[1]);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(y), entry[2]);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(view), 0);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(loop), 2);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(cel), 0);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(z), 0);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(signal), 0x2000); // SQ3 Ego default
+			writeSelectorValue(s->_segMan, ego, SELECTOR(illegalBits), 0x8000);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(xStep), 3);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(yStep), 2);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(moveSpeed), 0);
+			writeSelectorValue(s->_segMan, ego, SELECTOR(cycleSpeed), 0);
+			writeSelectorValue(s->_segMan, ego, g_sci->getKernel()->findSelector("edgeHit"), 0);
+		}
+	}
 	run_gc(s);
 	debugC(kDebugLevelRoom, "Entering room number %d", argv[0].toUint16());
 	return s->r_acc;
